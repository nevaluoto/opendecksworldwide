---
layout: base.njk
pagination:
  data: collections.continentPages
  size: 1
  alias: continent
permalink: "{{ continent.url }}"
eleventyComputed:
  title: "{{ continent.name }}"
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span aria-hidden="true">/</span> <span>{{ continent.name }}</span>
</nav>

<h1 class="neon-title">{{ continent.name }}</h1>
<p class="page-intro">{{ continent.eventCount }} active open decks event{% if continent.eventCount != 1 %}s{% endif %}.</p>

{% for country in continent.countries %}
  <section class="continent-section">
    <h2 class="section-title"><a href="{{ country.url }}">{{ country.name }}</a>
      <span class="count-pill">{{ country.eventCount }}</span>
    </h2>
    {% for state in country.states %}
      <div class="state-group">
        <h3 class="state-heading"><a href="{{ state.url }}">{{ state.name }}</a> <span class="count-pill">{{ state.eventCount }}</span></h3>
        {% for city in state.cities %}
          <h4 class="city-title"><a href="{{ city.url }}">{{ city.name }}</a></h4>
          <div class="card-grid">
            {% for venue in city.venues %}
              {% for event in venue.events %}
                {% set cardVenueName = venue.name %}
                {% set cardCityName = city.name %}
                {% set cardStateName = state.name %}
                {% set cardCountryName = country.name %}
                {% include "event-card.njk" %}
              {% endfor %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    {% endfor %}
    {% for city in country.cities %}
      <h3 class="city-title"><a href="{{ city.url }}">{{ city.name }}</a></h3>
      <div class="card-grid">
        {% for venue in city.venues %}
          {% for event in venue.events %}
            {% set cardVenueName = venue.name %}
            {% set cardCityName = city.name %}
            {% set cardCountryName = country.name %}
            {% include "event-card.njk" %}
          {% endfor %}
        {% endfor %}
      </div>
    {% endfor %}
  </section>
{% endfor %}
